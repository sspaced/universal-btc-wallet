# Bitcoin Network Configuration
VITE_BITCOIN_NETWORK=testnet
VITE_BITCOIN_API_URL=https://blockstream.info/testnet/api
VITE_OPI_INDEXER_URL=https://api.opi.network

# Security Configuration
VITE_CSP_NONCE=
VITE_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Encryption Configuration (DO NOT COMMIT THESE VALUES)
VITE_ENCRYPTION_KEY=
VITE_MASTER_SEED=

# Rate Limiting
VITE_RATE_LIMIT_WINDOW=900000
VITE_RATE_LIMIT_MAX_REQUESTS=100

# API Keys (DO NOT COMMIT THESE VALUES)
VITE_BLOCKCHAIN_API_KEY=
VITE_PRICE_API_KEY=

# Feature Flags
VITE_ENABLE_BIOMETRIC_AUTH=true
VITE_ENABLE_HARDWARE_WALLET=true
VITE_ENABLE_DEV_TOOLS=false

# Development Settings
VITE_DEBUG_MODE=false
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=info