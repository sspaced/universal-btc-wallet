    "class-validator": "^0.14.0",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.0.6",
    "framer-motion": "^10.16.16",
    "helmet": "^7.1.0",
    "inversify": "^6.0.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
